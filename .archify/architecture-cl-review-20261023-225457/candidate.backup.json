  "cards": [
    {
      "dot": "cyan",
      "title": "Read path",
      "items": [
        "refresh pulls the PL inventory and the SL scan into immutable snapshots",
        "re-matching upserts match rows and recomputes review state; existing decisions survive",
        "credentials are read from the environment by name, never stored in the database"
      ]
    },
    {
      "dot": "emerald",
      "title": "Review gate",
      "items": [
        "comparison flags copyright, license-name and license-text discrepancies",
        "review_status is derived, not typed: not_reviewed → review_required → in_progress → reviewed",
        "only a component at approved_for_sync can enter a synchronization job"
      ]
    },
    {
      "dot": "rose",
      "title": "Write path (SL → PL)",
      "items": [
        "live jobs need confirm=true, a PL connection that passed its connectivity test, and ≤ 500 items",
        "Black Duck exposes only update_licenses; copyright and license-text writes raise UnsupportedOperation",
        "no item is succeeded until a re-read of the target returns the approved value"
      ]
    }
  ]
