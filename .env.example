# Application environment for clreview-server. Copy to .env, fill in, then load it
# (`set -a; . ./.env; set +a`) before starting the server.
#
# NOT THE SAME FILE AS `.env.sample`: that one carries the SSSF agent-roster keys
# (OPENROUTER_API_KEY, FIREWORKS_API_KEY, OPENAI_API_KEY, PI_PATH, ...) for the agent
# tooling in `adws/`. Nothing in clreview reads them, and nothing in adws reads these.
#
# Credentials live only in the environment; the database stores variable names.

# ── server settings: read directly by clreview-server ─────────────────────────
# Each has an equivalent CLI flag (see README, "Configuration"). The flag wins.
# Path to the sqlite database.
CLREVIEW_DB=clreview.db
# Bind address. Any non-loopback bind without CLREVIEW_TOKEN logs a warning: the API
# has no other authentication.
CLREVIEW_HOST=127.0.0.1
# Bind port.
CLREVIEW_PORT=8765
# One of: debug | info | warning | error
CLREVIEW_LOG_LEVEL=info
# Optional shared API token; clients send `Authorization: Bearer <CLREVIEW_TOKEN>`.
CLREVIEW_TOKEN=

# ── names a connection's `auth_env` may point at ──────────────────────────────
# The server never reads these names. A connection stores the *name* of an environment
# variable in its `auth_env` map, and the connector resolves that name at call time.
# Exporting BLACKDUCK_URL changes nothing on its own: a tool's URL is the connection's
# `base_url` field, given when the connection is created.
#
# Black Duck (project-level)
BLACKDUCK_URL=https://blackduck.example
BLACKDUCK_TOKEN=

# FOSSology (source-level) — token preferred, basic auth fallback
FOSSOLOGY_URL=https://fossology.example
FOSSOLOGY_TOKEN=
FOSSOLOGY_USER=
FOSSOLOGY_PASS=

# ScanCode (source-level) — path to a `--json-pp` output file
SCANCODE_JSON=/path/to/scancode.json
